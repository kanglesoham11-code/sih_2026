# =====================================================
# ORCA Environment Variables
# Copy this to .env and fill in real values
# =====================================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-string
JWT_SECRET_KEY=change-me-to-a-random-string

# --- Database (PostgreSQL with PostGIS) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/orca

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (Groq — required for AI chat) ---
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,https://sih-2026-eight-sigma.vercel.app

# --- Frontend (set in Vercel dashboard for production) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Data Sources (Roadmap — not used in prototype) ---
INCOIS_API_KEY=
INCOIS_USERNAME=
INCOIS_PASSWORD=
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
IMD_API_KEY=
